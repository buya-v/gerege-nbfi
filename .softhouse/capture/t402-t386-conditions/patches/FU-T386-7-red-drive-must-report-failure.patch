diff --git a/.softhouse/capture/t381-t379-conditions/instruments/t381-red-drives.sh b/.softhouse/capture/t381-t379-conditions/instruments/t381-red-drives.sh
index 6b244ab7..9f8057da 100644
--- a/.softhouse/capture/t381-t379-conditions/instruments/t381-red-drives.sh
+++ b/.softhouse/capture/t381-t379-conditions/instruments/t381-red-drives.sh
@@ -446,3 +446,36 @@ else
 fi
 echo
 echo "END OF DRIVES."
+
+# =============================================================================================
+# [T402, closing FU-T386-7.] THIS DRIVE USED TO END HERE, ON AN `echo`, AND SO EXITED 0 WHATEVER
+# ITS ARMS SAID. Every `>>> ... DID NOT REPRODUCE` and `>>> ... THE REPAIR IS NOT PROVEN` branch
+# printed and continued. A reader who checked this drive's exit status learned nothing about this
+# drive -- which is P-45 applied to the very instrument written to enforce P-45, and T386's
+# re-run measured exactly that (`DRIVE_EXIT=0`).
+#
+# The accumulator is derived from the drive's OWN OUTPUT rather than from a counter threaded
+# through every arm, deliberately: threading a counter means editing eleven branches and trusting
+# that a twelfth is not added later without one. Re-reading the transcript this script just
+# printed catches an arm added tomorrow by an author who forgets, which is the failure mode that
+# produced this finding in the first place.
+if [ -n "${T381_DRIVE_LOG:-}" ] && [ -f "${T381_DRIVE_LOG:-}" ]; then
+  _t402_bad=$(grep -c -E 'DID NOT REPRODUCE|IS NOT PROVEN|DID NOT REFUSE' "$T381_DRIVE_LOG"); _t402_rc=$?
+  if [ "$_t402_rc" -ge 2 ]; then
+    echo "*** T402 GUARD: the drive's own transcript could not be re-read (grep rc=$_t402_rc), so" >&2
+    echo "*** this drive cannot report on itself. That is not a pass." >&2
+    exit 2
+  fi
+  if [ "$_t402_bad" -gt 0 ]; then
+    echo "*** $_t402_bad ARM(S) DID NOT REPRODUCE OR ARE NOT PROVEN. This drive now reports that" >&2
+    echo "*** through its exit status. [T402, FU-T386-7]" >&2
+    exit 1
+  fi
+  echo "T402 GUARD: every arm reproduced; DRIVE EXIT 0 now means something."
+  exit 0
+fi
+echo "*** T402 GUARD: run this drive as"
+echo "***   T381_DRIVE_LOG=<file> bash t381-red-drives.sh 2>&1 | tee \$T381_DRIVE_LOG"
+echo "*** so its exit status can report on its own arms. Without T381_DRIVE_LOG this script"
+echo "*** cannot grade itself, and it exits 2 rather than pretending to. [T402, FU-T386-7]" >&2
+exit 2
