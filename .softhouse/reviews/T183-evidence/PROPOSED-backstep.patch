+        _calls = [c for c in ast.walk(tree) if isinstance(c, ast.Call)]
+        for f in _fns:
+            for i, pname in enumerate(a.arg for a in f.args.args):
+                frags = []
+                for c in _calls:
+                    if dotted(c.func).split(".")[-1] != f.name or len(c.args) <= i:
+                        continue
+                    for n in ast.walk(c.args[i]):
+                        if isinstance(n, ast.Constant) and isinstance(n.value, str):
+                            frags.append(n.value)
+                        elif isinstance(n, ast.Name) and n.id in self.consts:
+                            frags.append(self.consts[n.id])
+                        elif isinstance(n, ast.Name) and n.id in self.partial:
+                            frags.append(self.partial[n.id])
+                if frags:
+                    self.partial.setdefault(pname, "/".join(frags))
