+        # ONE BACKWARD INTERPROCEDURAL STEP (T183).  `def patch(path, pairs): ...
+        # io.open(path, "w")` called as `patch(P, ...)` resolves to nothing above,
+        # because `path` is a PARAMETER.  The FORWARD mirror of this step is already
+        # taken for guards (`indirectly_guarded_funcs`); without the BACKWARD one,
+        # three in-place rewriters of the ratified DEC-1 land in UNKNOWN and
+        # `--enforce` exits 0 on them.  Feeds `partial`, so it can only ever change
+        # the reported SCOPE tag, never a guard verdict.
+        _fns = [f for f in ast.walk(tree)
