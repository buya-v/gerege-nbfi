+  print -r -- "mtime_age=$(( $(date +%s) - $(/usr/bin/stat -f %m "$LOCK" 2>/dev/null || print 0) ))   # printed only; decides nothing"
+  print -r -- "verdict=$(lock_decide "$_p" "$_r" "$_s" "$_t" "$_ps")"
+  exit 0
+fi
